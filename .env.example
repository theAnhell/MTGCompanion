POSTGRES_USER=mythictrack
POSTGRES_PASSWORD=mythictrack
POSTGRES_DB=mythictrack
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgres://mythictrack:mythictrack@db:5432/mythictrack

DJANGO_SECRET_KEY=change-me-for-anything-beyond-local-use
DJANGO_DEBUG=true

PORT=8000

GAMES_EXPORT_PATH=/app/data/AllGames.json
RETIRED_GLOBAL_PATH=/app/data/retired_decks.json
RETIRED_DIR_PATH=/app/data/retired
PLAYER_MERGES_PATH=/app/data/player-merges.json
MOXFIELD_DECKS_CONFIG_PATH=/app/data/moxfield-decks.json

# EDHREC inclusion-rate cutoffs (%) for the recommendation engine.
RECOMMENDATION_ADD_THRESHOLD=60.0
RECOMMENDATION_REMOVE_THRESHOLD=15.0

# Target counts for the archetype/deckbuilding-requirements check.
DECK_TARGET_RAMP=10
DECK_TARGET_DRAW=10
DECK_TARGET_REMOVAL=10
DECK_TARGET_LANDS=37
